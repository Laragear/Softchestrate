    "type": "file_match",
    "path": "src/a.php",
    "pattern": "'OldName'"
   },
   {
    "type": "file_match",
    "path": "src/b.php",
    "pattern": "extends NewName"
   },
   {
    "type": "file_match",
    "path": "src/b.php",
    "pattern": "'Old' \\. 'Name'"
   },
   {
    "type": "unchanged",
    "paths": [
     "vendor"
    ]
   },
   {
    "type": "report_match",
    "pattern": "SKIPPED"
   }
  ]
 },
